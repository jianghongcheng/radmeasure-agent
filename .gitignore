__pycache__/
*.py[cod]
.pytest_cache/
.venv/
dist/
build/
*.egg-info/
.env
.env.*
!.env.example
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
node_modules/

# Models, runtime state, and generated research outputs are never committed.
models/
runtime/
outputs/research/
outputs/harbor/
outputs/**/*.pt
outputs/**/*.pth
outputs/**/*.ckpt
outputs/**/*.safetensors

# Upstream datasets and cloned third-party repositories are fetched separately.
third_party/

# Medical images and derived manifests stay local unless redistribution rights
# have been reviewed explicitly.
data/processed/
data/local/

# Keep work logs and generated artifacts out of public releases.
outputs/
protocols/
docs/*
!docs/USAGE.md
!docs/ARCHITECTURE.md
!docs/EVALUATION.md
!docs/assets/
docs/assets/*
!docs/assets/dashboard.png
!docs/assets/workflow.svg
!docs/results/
docs/results/*
!docs/results/selective_repair_summary.json
*.sqlite
*.sqlite3
*.db
*.log
*.pt
*.pth
*.ckpt
*.safetensors
