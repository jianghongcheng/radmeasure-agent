# Local model files are intentionally excluded from Git.
RADMEASURE_RESNET_CHECKPOINT=./models/best_resnet.pt
RADMEASURE_LANDMARK_CHECKPOINT=./models/hrnet_lm.pt
RADMEASURE_REPAIR_CHECKPOINT=./models/repair_mlp_verifier.pt

# Optional local Qwen planner through Ollama.
RADMEASURE_PLANNER_PROVIDER=ollama
RADMEASURE_PLANNER_BASE_URL=http://host.docker.internal:11434
RADMEASURE_PLANNER_MODEL=qwen3:8b
RADMEASURE_PLANNER_TIMEOUT_SECONDS=30

# Image-first LangGraph workflow
RADMEASURE_VLM_URL=
RADMEASURE_VLM_MODEL=
RADMEASURE_VLM_API_KEY=
RADMEASURE_DISCREPANCY_POLICY=
OPENAI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_API_KEY=
GEMINI_MODEL=
GEMINI_API_KEY=
